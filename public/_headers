/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: credentialless
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Permissions-Policy: accelerometer=(), autoplay=(), camera=(), clipboard-read=(), display-capture=(), encrypted-media=(), fullscreen=(self), geolocation=(), gyroscope=(), hid=(), magnetometer=(), microphone=(), midi=(), payment=(), publickey-credentials-get=(), screen-wake-lock=(), serial=(), usb=(), xr-spatial-tracking=(), browsing-topics=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-SwIIC/t6xpWC+7oykEkTi5sySbExurzWGtxBVsDQhKw='; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' https://api.github.com; frame-src 'self'; frame-ancestors 'self'; object-src 'none'; base-uri 'self'; form-action 'self' https://github.com; upgrade-insecure-requests;
  Cache-Control: public, max-age=0, must-revalidate
  Server-Timing: cfEdge;desc="Cloudflare Edge"

/assets/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
  Server-Timing: cfEdge;desc="Cloudflare Edge"

/manifest.webmanifest
  ! Cache-Control
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
  Content-Type: application/manifest+json; charset=utf-8
  Server-Timing: cfEdge;desc="Cloudflare Edge"

/favicon.ico
  ! Cache-Control
  Cache-Control: public, max-age=604800
  Server-Timing: cfEdge;desc="Cloudflare Edge"

/robots.txt
  ! Cache-Control
  Cache-Control: public, max-age=86400
  Content-Type: text/plain; charset=utf-8
  Server-Timing: cfEdge;desc="Cloudflare Edge"

/sitemap.xml
  ! Cache-Control
  Cache-Control: public, max-age=86400
  Content-Type: application/xml; charset=utf-8
  Server-Timing: cfEdge;desc="Cloudflare Edge"

/.well-known/security.txt
  ! Cache-Control
  Cache-Control: public, max-age=86400
  Content-Type: text/plain; charset=utf-8
  Server-Timing: cfEdge;desc="Cloudflare Edge"

/assets/*.pdf
  Content-Type: application/pdf
  Content-Disposition: inline
  Cache-Control: public, max-age=31536000, immutable