/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: credentialless
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=(), serial=(), midi=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-SwIIC/t6xpWC+7oykEkTi5sySbExurzWGtxBVsDQhKw=' 'sha256-sElDK8fGbwGc67BqDKdbkmr3wczI0wNnmewluPFd1To=' 'sha256-+ptRHRNStOc6bfJy9u6smdzur88zF4eLImI2Zec3WWQ='; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' https://api.github.com; frame-src 'self'; frame-ancestors 'self'; object-src 'none'; base-uri 'self'; form-action 'none';
  Cache-Control: public, max-age=0, must-revalidate
  Server-Timing: cfEdge;desc="Cloudflare Edge"

/assets/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *
  Server-Timing: cfEdge;desc="Cloudflare Edge"

/manifest.webmanifest
  ! Cache-Control
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
  Content-Type: application/manifest+json; charset=utf-8
  Access-Control-Allow-Origin: *
  Server-Timing: cfEdge;desc="Cloudflare Edge"

/favicon.ico
  ! Cache-Control
  Cache-Control: public, max-age=604800
  Server-Timing: cfEdge;desc="Cloudflare Edge"

/robots.txt
  ! Cache-Control
  Cache-Control: public, max-age=86400
  Content-Type: text/plain; charset=utf-8
  Server-Timing: cfEdge;desc="Cloudflare Edge"

/sitemap.xml
  ! Cache-Control
  Cache-Control: public, max-age=86400
  Content-Type: application/xml; charset=utf-8
  Server-Timing: cfEdge;desc="Cloudflare Edge"